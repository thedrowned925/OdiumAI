# Public URL of the Odium backend. Never put provider secrets in VITE_* variables.
VITE_ODIUM_API_BASE_URL=http://localhost:8787

# Private backend-only Gemini credentials.
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.6-flash
PORT=8787

# Comma-separated browser origins allowed to call the backend.
ODIUM_ALLOWED_ORIGINS=http://localhost:5173,https://thedrowned925.github.io
ODIUM_REQUESTS_PER_MINUTE=20
